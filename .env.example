# PostgreSQL DSN. Leave unset to run fully offline against bundled fixtures.
DATABASE_URL=postgresql://t2s:t2s@localhost:5432/shop

# OpenAI API key. Leave unset to use the deterministic FakeLLM + FakeEmbedder.
OPENAI_API_KEY=

# Chat model used for SQL generation, correction, and result summaries.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for schema-card and few-shot retrieval.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LIMIT injected into any generated query that does not already have one.
DEFAULT_ROW_LIMIT=200

# How many times the LLM may retry after a validation or execution failure.
MAX_CORRECTION_ROUNDS=2

# Per-statement timeout enforced on every database call (milliseconds).
STATEMENT_TIMEOUT_MS=5000

# Approximate token budget for schema cards included in the prompt.
SCHEMA_TOKEN_BUDGET=1200

# Comma-separated tables where SELECT * is denied (PII protection).
SENSITIVE_TABLES=customers

# SQLite file where query history is persisted.
HISTORY_DB_PATH=artifacts/history.sqlite
